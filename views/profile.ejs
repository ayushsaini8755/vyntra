<% include ./partials/header.ejs %>
<div class="w-full min-h-screen bg-zinc-900 text-white py-5">
    <form hidden id="uploadform" action="/fileupload" method="post" enctype="multipart/form-data">
        <input type="file" name="image">
    </form>
    <div class="nav flex justify-between items-center px-4">
        <h3 class="text-lg"><%= user.username %></h3>
    </div>
    <div class="profdets flex flex-col mt-10 px-2">
        <div class="relative">
            <span id="uploadicon" class="w-8 h-8 absolute bottom-5 left-40 bg-zinc-200 rounded-full flex items-center justify-center">
                <i class="text-zinc-800 ri-pencil-fill border-zinc-900"></i>
            </span>
            <div class="w-50 h-50 bg-zinc-200 rounded-full overflow-hidden">
                <img class="w-full h-full object-cover bg-sky-100" src="<%= user.profileImage %>">
            </div>
        </div>
        <div class="flex flex-col justify-between px-4">
            <h3 class="text-2xl py-2"><%= user.name %></h3>
            <p class="w-80 tracking-tight opacity-50 text-sm"><%= user.bio ?? "You have not set anything yet, (click edit profile to set)" %></p>
        </div>
        <div class="px-3 py-5 flex gap-5">
            <a class="px-3 py-2 bg-zinc-800 text-xs rounded-md" href="/edit">Edit Profile</a>
            <a class="px-5 py-2 bg-red-500 text-xs rounded-md" href="/logout">Logout</a>
        </div>
        <div class="w-full flex gap-1 py-2 mt-5 flex-wrap">
            <% if(user.posts.length>0){ %>
            <% user.posts.reverse().forEach(function(elem){ %>
                <div class="w-[32.5%] h-32 bg-sky-100">
                    <img class="w-full h-full" src="<%= elem.image %>">
                </div>
           <% }) %>
           <% }  else { %>
          <div class="w-full flex justify-center items-center min-h-[20vh]">
            <small class="opacity-50">no posts yet.</small>
          </div>
        <% } %>
        </div>
</div>

<script>
    let uploadicon = document.querySelector("#uploadicon");
    uploadicon.addEventListener('click', ()=>{
        document.querySelector("#uploadform input").click();
    });
    document.querySelector("#uploadform input").addEventListener('change', ()=>{
        document.querySelector("#uploadform").submit();
    });

</script>

<%include ./partials/footer.ejs %>
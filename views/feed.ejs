<% include ./partials/header.ejs %> 
<div class="w-full min-h-screen bg-zinc-900 text-white py-5 flex flex-col">
    <div class="w-full px-4 flex items-center justify-between">
      <img class="w-1/4" src="/images/Vyntra Gradient Wordmark.png" alt="">
      <div id="later" class="icons -mt-2 flex gap-5 items-center">
        <i class="text-[1.4rem] ri-heart-3-line"></i>
        <i class="text-[1.4rem] ri-messenger-line"></i>
      </div>
    </div>
    <div class="story px-3 flex gap-3 overflow-auto mt-5">
      <div class="w-full flex gap-5">
      <a href="/story">
        <div class="w-[25vh] h-50 rounded-md flex flex-col items-center justify-center bg-gradient-to-r from-purple-700 to-orange-500 overflow-hidden" id="story-box">
          <img class="bg-zinc-300 rounded-full w-30 h-30" src="/images/back_cover.webp">
          <h1 class="mt-3">Create Story</h1>
        </div>
      </a>
        <% stories.forEach(function(item){ %>
          <a>
          <div id="show" class="w-[25vh] h-50 rounded-md flex flex-col items-center justify-center bg-gradient-to-r from-purple-700 to-orange-500 overflow-hidden">
            <img class="bg-zinc-300 rounded-full w-30 h-30" src="/images/uploads/<%= item.storyImage %>">
            <h1 class="mt-3">View Story</h1>
          </div>
          </a>
       <% }) %>
      </div>
    </div>
    <div class="w-full bg-zinc-900 flex flex-col py-10">
      <% posts.reverse().forEach(function(elem){ %> 
      <div class="flex flex-col">
        <div class="w-full items-center flex overflow-hidden px-2">
          <img src="/images/uploads/<%= elem.user.profileImage %>" class="w-15 h-15 rounded-full bg-sky-100 border-1">
          <h3 class="px-3 py-12"><%= elem.user.username %></h3>
        </div>
        <div class="w-full h-auto">
          <% if(elem.image){ %> 
            <img src="/images/uploads/<%= elem.image %>" class="w-full h-220 bg-sky-100 object-cover" id="postheight">
          <% } %>
          </div>
        <div class="options w-full px-4 flex items-center text-[1.4rem]">
          <div class="flex gap-3 mt-2">
            <i class="heart ri-heart-3-line" id="like"></i>
          </div>
          <div class="flex gap-3 mt-2 px-3">
            <i class="ri-chat-3-line" id="later"></i>
            <form action="/delete/post/<%= elem._id %>" method="post">
              <button type="submit">
                <i class="ri-delete-bin-3-line"></i>
              </button>
            </form>
          </div>
        </div>
        <div class="flex">
          <h2 class="py-3 px-4 text-xm"><%= elem.user.username %></h2>
          <h2 class="py-3 text-xm font-light text-zinc-400"><%= elem.caption %></h2>
        </div>
      </div>
      <% }) %>
    </div>
</div>
<script>
    document.querySelectorAll("#later").forEach(function(later){
      later.addEventListener('click', ()=>{
      alert("This function not added yet");
    });
  });
    document.querySelectorAll("#like").forEach(function(like){
      like.addEventListener("click", ()=>{
        if(like.classList.contains("ri-heart-3-line")){
          like.classList.remove("ri-heart-3-line");
          like.classList.add("ri-heart-3-fill");
          like.style.color = "red";
        }
        else{
          like.classList.remove("ri-heart-3-fill");
          like.classList.add("ri-heart-3-line");
          like.style.color = "white";
        }
      })
    });

    document.querySelectorAll("#show").forEach(function(show){
      show.addEventListener('click', ()=> {
        setTimeout(() => {
          window.location.href = "/watch"
        }, 100);
      })

    })
</script>
<% include ./partials/footer.ejs %>